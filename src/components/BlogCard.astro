---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { contentPath } from '../utils/paths';
import { formatDate } from '../utils/dates';
import { getReadingMinutes } from '../utils/content';
import LanguageAvailability from './LanguageAvailability.astro';
import type { Language } from '../utils/i18n';
interface Props { blog: CollectionEntry<'blogs'>; availableLanguages?:Language[]; }
const { blog, availableLanguages } = Astro.props;
const minutes = getReadingMinutes(blog);
---
<article class="blog-card">
  <a class="image" href={contentPath(blog.data.lang, 'blog', blog.data.routeSlug)} tabindex="-1" aria-hidden="true">
    {blog.data.cover ? <Image src={blog.data.cover} alt="" widths={[480,720,960]} sizes="(min-width: 48rem) 33vw, 100vw" /> : <span></span>}
  </a>
  <div>
    <div class="meta-row"><p class="eyebrow">{[blog.data.category, formatDate(blog.data.publishedAt, blog.data.lang), blog.data.lang === 'bn' ? `${new Intl.NumberFormat('bn-BD').format(minutes)} মিনিট` : `${minutes} min`].filter(Boolean).join(' · ')}</p>{availableLanguages && <LanguageAvailability current={blog.data.lang} available={availableLanguages} />}</div>
    <h2><a href={contentPath(blog.data.lang, 'blog', blog.data.routeSlug)}>{blog.data.title}</a></h2>
    <p class="excerpt">{blog.data.excerpt}</p>
  </div>
</article>
<style>
  .blog-card { display:grid; gap:var(--space-4); padding-block:var(--space-5); border-top:1px solid var(--color-border); }
  .image { aspect-ratio:16/10; overflow:hidden; background:var(--color-sand); }
  .image :global(img), .image span { width:100%; height:100%; object-fit:cover; }
  .meta-row { display:flex; flex-wrap:wrap; gap:var(--space-2) var(--space-4); align-items:baseline; justify-content:space-between; }
  .meta-row .eyebrow { margin-bottom:0; }
  h2 { margin-bottom:var(--space-3); font-family:var(--font-serif-latin); font-size:var(--step-2); line-height:1.25; }
  :global(html[lang='bn']) h2 { font-family:var(--font-serif-bengali); line-height:1.45; }
  h2 a { text-decoration:none; }
  .excerpt { margin:0; color:var(--color-ink-soft); }
  @media(min-width:48rem){ .blog-card { grid-template-columns:minmax(13rem,.6fr) minmax(0,1.4fr); gap:var(--space-6); align-items:center; } }
</style>
