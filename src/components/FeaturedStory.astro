---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { contentPath } from '../utils/paths';
import { formatDate } from '../utils/dates';
interface Props { story: CollectionEntry<'stories'>; }
const { story } = Astro.props;
---
<article class="featured-story">
  <a class="featured-image" href={contentPath(story.data.lang, 'story', story.data.routeSlug)} tabindex="-1" aria-hidden="true">
    {story.data.cover ? <Image src={story.data.cover} alt="" widths={[640,960,1280,1600]} sizes="(min-width: 60rem) 60vw, 100vw" loading="eager" /> : <span class="image-fallback"></span>}
  </a>
  <div class="featured-copy">
    <p class="eyebrow">{[story.data.location, formatDate(story.data.publishedAt, story.data.lang)].filter(Boolean).join(' · ')}</p>
    <h2><a href={contentPath(story.data.lang, 'story', story.data.routeSlug)}>{story.data.title}</a></h2>
    {story.data.subtitle && <p class="subtitle">{story.data.subtitle}</p>}
    <p class="excerpt">{story.data.excerpt}</p>
    <a class="read-link" href={contentPath(story.data.lang, 'story', story.data.routeSlug)}>{story.data.lang === 'bn' ? 'স্টোরি পড়ুন' : 'Read the story'} <span aria-hidden="true">→</span></a>
  </div>
</article>
<style>
  .featured-story { display:grid; gap:var(--space-6); }
  .featured-image { min-height:22rem; overflow:hidden; background:var(--color-sand); }
  .featured-image :global(img), .image-fallback { width:100%; height:100%; min-height:22rem; object-fit:cover; transition:transform 500ms ease; }
  .featured-image:hover :global(img) { transform:scale(1.015); }
  .featured-copy { align-self:center; max-width:35rem; }
  .featured-copy h2 { margin-bottom:var(--space-4); font-family:var(--font-serif-latin); font-size:var(--step-4); line-height:1.08; }
  :global(html[lang='bn']) .featured-copy h2 { font-family:var(--font-serif-bengali); line-height:1.34; }
  h2 a, .read-link { text-decoration:none; }
  .subtitle { font-family:var(--font-serif-latin); font-size:var(--step-1); }
  :global(html[lang='bn']) .subtitle { font-family:var(--font-serif-bengali); }
  .excerpt { color:var(--color-ink-soft); }
  .read-link { display:inline-block; margin-top:var(--space-3); font-weight:700; }
  @media (min-width:60rem) { .featured-story { grid-template-columns:minmax(0,1.45fr) minmax(19rem,.75fr); gap:clamp(3rem,6vw,7rem); } }
</style>
