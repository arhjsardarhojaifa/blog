---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { siteConfig } from '../config/site';
import type { Language } from '../utils/i18n';

interface AlternateLink {
  lang: Language;
  href: string;
}

interface Props {
  lang: Language;
  title: string;
  rawTitle: string;
  description: string;
  canonicalPath: string;
  alternateLinks?: AlternateLink[];
  noIndex?: boolean;
  socialImage?: ImageMetadata | string;
  socialImageAlt?: string;
  ogType?: 'website' | 'article';
  schemaType?: 'WebPage' | 'Article' | 'BlogPosting' | 'ImageGallery';
  publishedAt?: Date;
  updatedAt?: Date;
  section?: string;
  tags?: string[];
}

const {
  lang,
  title,
  rawTitle,
  description,
  canonicalPath,
  alternateLinks = [],
  noIndex = false,
  socialImage,
  socialImageAlt,
  ogType = 'website',
  schemaType = 'WebPage',
  publishedAt,
  updatedAt,
  section,
  tags = []
} = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withConfiguredBase = (value: string) => {
  if (/^https?:\/\//i.test(value)) return value;
  if (!value.startsWith('/') || !base || base === '/') return value;
  if (value === base || value.startsWith(`${base}/`)) return value;
  return `${base}${value}`.replace(/\/{2,}/g, '/');
};
const absoluteUrl = (value: string) => {
  if (/^https?:\/\//i.test(value)) return value;
  return new URL(withConfiguredBase(value), origin).toString();
};

const canonicalUrl = absoluteUrl(canonicalPath);
const homeUrl = absoluteUrl(import.meta.env.BASE_URL || '/');
const absoluteAlternateLinks = alternateLinks.map((item) => ({
  ...item,
  href: absoluteUrl(item.href)
}));
const xDefaultHref = absoluteAlternateLinks.find((item) => item.lang === 'en')?.href
  ?? absoluteAlternateLinks[0]?.href;

let imageSrc: string | undefined;
if (typeof socialImage === 'string') {
  imageSrc = socialImage;
} else if (socialImage) {
  const generated = await getImage({ src: socialImage, width: 1200, format: 'jpeg', quality: 82 });
  imageSrc = generated.src;
}
const socialImageUrl = imageSrc ? absoluteUrl(imageSrc) : undefined;
const ogLocale = lang === 'bn' ? 'bn_BD' : 'en_US';
const alternateOgLocales = absoluteAlternateLinks
  .filter((item) => item.lang !== lang)
  .map((item) => item.lang === 'bn' ? 'bn_BD' : 'en_US');

const isEditorial = schemaType !== 'WebPage';
const schema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  ...(isEditorial ? { headline: rawTitle } : { name: rawTitle }),
  description,
  inLanguage: lang,
  url: canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: siteConfig.title,
    url: homeUrl
  },
  ...(socialImageUrl ? { image: socialImageUrl } : {}),
  ...(publishedAt ? { datePublished: publishedAt.toISOString() } : {}),
  ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
  ...(section ? { articleSection: section } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {})
};

// Avoid a literal </script> sequence if user-authored metadata ever contains it.
const serializedSchema = JSON.stringify(schema).replace(/</g, '\\u003c');
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="theme-color" content="#0b0d10" />
<meta name="color-scheme" content="dark" />
{noIndex && <meta name="robots" content="noindex,follow" />}

<link rel="canonical" href={canonicalUrl} />
{absoluteAlternateLinks.map((item) => (
  <link rel="alternate" hreflang={item.lang} href={item.href} />
))}
{xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={ogLocale} />
{alternateOgLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
<meta property="og:url" content={canonicalUrl} />
{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
{socialImageUrl && socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}

{ogType === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{ogType === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
{ogType === 'article' && section && <meta property="article:section" content={section} />}
{ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
{socialImageUrl && socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}

<title>{title}</title>
<script type="application/ld+json" is:inline set:html={serializedSchema}></script>
