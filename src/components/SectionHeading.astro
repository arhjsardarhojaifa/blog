---
interface Props { eyebrow?: string; title: string; href?: string; linkLabel?: string; }
const { eyebrow, title, href, linkLabel } = Astro.props;
---
<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
  </div>
  {href && linkLabel && <a href={href}>{linkLabel}<span aria-hidden="true"> →</span></a>}
</div>
<style>
  .section-heading { display:flex; gap:var(--space-5); align-items:end; justify-content:space-between; margin-bottom:var(--space-6); padding-bottom:var(--space-4); border-bottom:1px solid var(--color-border); }
  .eyebrow { margin-bottom:var(--space-2); }
  h2 { margin:0; font-family:var(--font-serif-latin); font-size:var(--step-3); line-height:1.15; }
  :global(html[lang='bn']) h2 { font-family:var(--font-serif-bengali); line-height:1.35; }
  a { flex:none; font-size:var(--step--1); font-weight:700; text-decoration:none; }
</style>
