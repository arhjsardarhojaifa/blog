---
import {getCollection,render,type CollectionEntry} from 'astro:content';import {Image} from 'astro:assets';import BaseLayout from '../../../layouts/BaseLayout.astro';import Gallery from '../../../components/Gallery.astro';import RelatedContent from '../../../components/RelatedContent.astro';import {getTranslation,getByTranslationKeys} from '../../../utils/content';import {oppositeLanguage} from '../../../utils/i18n';import {contentPath} from '../../../utils/paths';import {formatDate} from '../../../utils/dates';
export async function getStaticPaths(){const entries=await getCollection('photography',({data})=>!data.draft);return entries.map((entry)=>({params:{lang:entry.data.lang,slug:entry.data.routeSlug},props:{entry}}))}
interface Props{entry:CollectionEntry<'photography'>}const {entry}=Astro.props;const lang=entry.data.lang;const altLang=oppositeLanguage(lang);const translation=await getTranslation('photography',entry.data.translationKey,altLang);const {Content}=await render(entry);const relatedStories=await getByTranslationKeys('stories',entry.data.relatedStories,lang);const relatedBlogs=await getByTranslationKeys('blogs',entry.data.relatedBlogs,lang);const currentPath=contentPath(lang,'photography',entry.data.routeSlug);const altPath=translation?contentPath(altLang,'photography',translation.data.routeSlug):undefined;
---
<BaseLayout lang={lang} title={entry.data.title} seoTitle={entry.data.seo?.title} description={entry.data.seo?.description??entry.data.description??entry.data.title} canonicalPath={currentPath} alternateHref={altPath} alternateAvailable={Boolean(translation)} alternateLinks={[{lang,href:currentPath},...(altPath?[{lang:altLang,href:altPath}]:[])]} noIndex={entry.data.seo?.noIndex} socialImage={entry.data.cover} socialImageAlt={entry.data.seo?.ogImageAlt??entry.data.coverAlt} ogType="article" schemaType="ImageGallery" publishedAt={entry.data.publishedAt} updatedAt={entry.data.updatedAt} section={entry.data.category} tags={entry.data.tags}>
  <article class="photo-article"><header class="photo-header container"><p class="eyebrow">{[entry.data.location,formatDate(entry.data.publishedAt,lang)].filter(Boolean).join(' · ')}</p><h1>{entry.data.title}</h1>{entry.data.description&&<p>{entry.data.description}</p>}</header>{entry.data.cover&&<div class="cover container--wide"><Image src={entry.data.cover} alt={entry.data.coverAlt??''} widths={[720,960,1280,1600,2000]} sizes="(min-width:94rem) 90rem,100vw" loading="eager" /></div>}<div class="intro prose prose--blog"><Content /></div>{entry.data.images.length>0?<div class="container--wide gallery-wrap"><Gallery lang={lang} images={entry.data.images}/></div>:<p class="container empty">{lang==='bn'?'এই সংগ্রহে এখনো কোনো ছবি যোগ করা হয়নি।':'No gallery images have been added to this collection yet.'}</p>}<RelatedContent lang={lang} stories={relatedStories} blogs={relatedBlogs}/></article>
</BaseLayout>
<style>.photo-article{padding-top:clamp(3rem,7vw,7rem)}.photo-header{max-width:60rem;margin-bottom:var(--space-7);text-align:center}.photo-header h1{margin-bottom:var(--space-4);font-family:var(--font-serif-latin);font-size:var(--step-5);line-height:1.05}:global(html[lang='bn']) .photo-header h1{font-family:var(--font-serif-bengali);line-height:1.3}.photo-header>p:last-child{max-width:42rem;margin-inline:auto;color:var(--color-ink-soft)}.cover{margin-bottom:var(--space-8)}.cover :global(img){width:100%;max-height:80vh;object-fit:cover}.intro{margin-bottom:var(--space-8)}.gallery-wrap{margin-top:var(--space-7)}.empty{text-align:center;color:var(--color-ink-soft)}</style>
