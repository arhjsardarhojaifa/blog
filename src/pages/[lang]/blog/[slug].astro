---
import {getCollection,render,type CollectionEntry} from 'astro:content';import ArticleLayout from '../../../layouts/ArticleLayout.astro';import RelatedContent from '../../../components/RelatedContent.astro';import {getTranslation,getByTranslationKeys,getReadingMinutes} from '../../../utils/content';import {oppositeLanguage} from '../../../utils/i18n';import {contentPath} from '../../../utils/paths';
export async function getStaticPaths(){const entries=await getCollection('blogs',({data})=>!data.draft);return entries.map((entry)=>({params:{lang:entry.data.lang,slug:entry.data.routeSlug},props:{entry}}))}
interface Props{entry:CollectionEntry<'blogs'>}const {entry}=Astro.props;const lang=entry.data.lang;const altLang=oppositeLanguage(lang);const translation=await getTranslation('blogs',entry.data.translationKey,altLang);const {Content}=await render(entry);const relatedStories=await getByTranslationKeys('stories',entry.data.relatedStories,lang);const relatedBlogs=await getByTranslationKeys('blogs',entry.data.relatedBlogs,lang);const relatedPhotography=await getByTranslationKeys('photography',entry.data.relatedPhotography,lang);const currentPath=contentPath(lang,'blog',entry.data.routeSlug);const altPath=translation?contentPath(altLang,'blog',translation.data.routeSlug):undefined;
---
<ArticleLayout lang={lang} title={entry.data.title} seoTitle={entry.data.seo?.title} description={entry.data.seo?.description??entry.data.excerpt} cover={entry.data.cover} coverAlt={entry.data.coverAlt??''} socialImageAlt={entry.data.seo?.ogImageAlt??entry.data.coverAlt??''} date={entry.data.publishedAt} updatedAt={entry.data.updatedAt} location={entry.data.location} category={entry.data.category} tags={entry.data.tags} readingMinutes={getReadingMinutes(entry)} alternateHref={altPath} alternateAvailable={Boolean(translation)} canonicalPath={currentPath} alternateLinks={[{lang,href:currentPath},...(altPath?[{lang:altLang,href:altPath}]:[])]} noIndex={entry.data.seo?.noIndex} contentType="blog">
  <Content />
  <div slot="after-article"><RelatedContent lang={lang} stories={relatedStories} blogs={relatedBlogs} photography={relatedPhotography}/></div>
</ArticleLayout>
