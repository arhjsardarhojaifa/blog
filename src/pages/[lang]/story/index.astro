---
import BaseLayout from '../../../layouts/BaseLayout.astro';import PageIntro from '../../../components/PageIntro.astro';import StoryCard from '../../../components/StoryCard.astro';import EmptyState from '../../../components/EmptyState.astro';import {getVisibleCollection,getAvailabilityMap} from '../../../utils/content';import {isLanguage,oppositeLanguage} from '../../../utils/i18n';import {localizedPath} from '../../../utils/paths';
export function getStaticPaths(){return[{params:{lang:'bn'}},{params:{lang:'en'}}]} const {lang:paramLang}=Astro.params;if(!isLanguage(paramLang))throw new Error('Unsupported language');const lang=paramLang;const alt=oppositeLanguage(lang);const stories=await getVisibleCollection('stories',lang);const availability=getAvailabilityMap(await getVisibleCollection('stories'));
const title=lang==='bn'?'স্টোরি':'Story';const intro=lang==='bn'?'অভিজ্ঞতা, আবহ, মানুষ, প্রকৃতি ও স্মৃতির ভেতর দিয়ে জায়গাকে অনুভব করার দীর্ঘপাঠ।':'Long-form travel narratives built around atmosphere, experience, people, nature and memory.';
---
<BaseLayout lang={lang} title={title} description={intro} alternateHref={localizedPath(alt,'story')} alternateAvailable={true} alternateLinks={[{lang,href:localizedPath(lang,'story')},{lang:alt,href:localizedPath(alt,'story')}]}> <div class="container"><PageIntro eyebrow={lang==='bn'?'অভিজ্ঞতা ও নিমজ্জন':'Experience & immersion'} title={title} intro={intro}/>{stories.length?stories.map((story)=><StoryCard story={story} availableLanguages={availability.get(story.data.translationKey)}/>):<EmptyState lang={lang} type="story"/>}</div></BaseLayout>
