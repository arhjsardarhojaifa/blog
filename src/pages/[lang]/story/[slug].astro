---
import {getCollection,render,type CollectionEntry} from 'astro:content';import ArticleLayout from '../../../layouts/ArticleLayout.astro';import RelatedContent from '../../../components/RelatedContent.astro';import {getTranslation,getByTranslationKeys,getVisibleCollection,getReadingMinutes} from '../../../utils/content';import {oppositeLanguage} from '../../../utils/i18n';import {contentPath} from '../../../utils/paths';
export async function getStaticPaths(){const entries=await getCollection('stories',({data})=>!data.draft);return entries.map((entry)=>({params:{lang:entry.data.lang,slug:entry.data.routeSlug},props:{entry}}))}
interface Props{entry:CollectionEntry<'stories'>} const {entry}=Astro.props;const lang=entry.data.lang;const altLang=oppositeLanguage(lang);const translation=await getTranslation('stories',entry.data.translationKey,altLang);const {Content}=await render(entry);const reading=getReadingMinutes(entry);
const relatedStories=await getByTranslationKeys('stories',entry.data.relatedStories,lang);const relatedBlogs=await getByTranslationKeys('blogs',entry.data.relatedBlogs,lang);const relatedPhotography=await getByTranslationKeys('photography',entry.data.relatedPhotography,lang);const all=await getVisibleCollection('stories',lang);const index=all.findIndex((item)=>item.id===entry.id);const previous=index>=0?all[index+1]:undefined;const next=index>0?all[index-1]:undefined;const currentPath=contentPath(lang,'story',entry.data.routeSlug);const altPath=translation?contentPath(altLang,'story',translation.data.routeSlug):undefined;
---
<ArticleLayout lang={lang} title={entry.data.title} seoTitle={entry.data.seo?.title} description={entry.data.seo?.description??entry.data.excerpt} subtitle={entry.data.subtitle} cover={entry.data.cover} coverAlt={entry.data.coverAlt??''} socialImageAlt={entry.data.seo?.ogImageAlt??entry.data.coverAlt??''} date={entry.data.publishedAt} updatedAt={entry.data.updatedAt} location={entry.data.location} category={entry.data.category} tags={entry.data.tags} readingMinutes={reading} alternateHref={altPath} alternateAvailable={Boolean(translation)} canonicalPath={currentPath} alternateLinks={[{lang,href:currentPath},...(altPath?[{lang:altLang,href:altPath}]:[])]} noIndex={entry.data.seo?.noIndex} contentType="story">
  <Content />
  <div slot="after-article">
    {(previous||next)&&<nav class="previous-next container" aria-label={lang==='bn'?'স্টোরি নেভিগেশন':'Story navigation'}><div>{previous&&<a href={contentPath(lang,'story',previous.data.routeSlug)}><small>{lang==='bn'?'← আগের স্টোরি':'← Previous story'}</small><strong>{previous.data.title}</strong></a>}</div><div class="next">{next&&<a href={contentPath(lang,'story',next.data.routeSlug)}><small>{lang==='bn'?'পরের স্টোরি →':'Next story →'}</small><strong>{next.data.title}</strong></a>}</div></nav>}
    <RelatedContent lang={lang} stories={relatedStories} blogs={relatedBlogs} photography={relatedPhotography}/>
  </div>
</ArticleLayout>
<style>.previous-next{display:grid;gap:var(--space-5);margin-top:var(--space-9);padding-block:var(--space-6);border-block:1px solid var(--color-border)}.previous-next a{display:grid;gap:var(--space-2);text-decoration:none}.previous-next small{color:var(--color-ink-soft)}.previous-next strong{font-family:var(--font-serif-latin);font-size:var(--step-1)}:global(html[lang='bn']) .previous-next strong{font-family:var(--font-serif-bengali)}.next{text-align:right}@media(min-width:48rem){.previous-next{grid-template-columns:1fr 1fr}}</style>
